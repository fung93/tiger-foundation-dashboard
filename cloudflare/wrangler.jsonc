{
  // Deploy on a Cloudflare Workers Free account. Do not enable a paid plan or
  // paid fallback. Free allowances are finite; exhaustion pauses service.
  "name": "tiger-foundation-dashboard",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "AGENT_DB",
      "database_name": "tiger-agent-private",
      "database_id": "32405a9c-f592-4f18-88dd-fbdfb2f5db0c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AGENT_ORIGIN": "https://tiger-foundation-dashboard.vercel.app",
    "AGENT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AGENT_INFERENCE_ENABLED": "true",
    "AGENT_RESEARCH_ENABLED": "true",
    "AGENT_STRATEGY_ENABLED": "true",
    "AGENT_DAILY_NEURON_LIMIT": "5000",
    "AGENT_DAILY_MESSAGE_LIMIT": "40"
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
