# Free-plan agent: set these privately; never put real secrets in this file.
# Dashboard/Vercel needs only AGENT_WORKER_URL and AGENT_GATEWAY_SECRET.
# The other settings belong to the Cloudflare Worker or setup CLI.
AGENT_ORIGIN=https://tiger-foundation-dashboard.vercel.app
AGENT_WORKER_URL=https://YOUR-AGENT.YOUR-ACCOUNT.workers.dev
AGENT_GATEWAY_SECRET=
AGENT_ACCESS_KEY=
AGENT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AGENT_DAILY_MESSAGE_LIMIT=40
AGENT_DAILY_NEURON_LIMIT=5000
AGENT_INFERENCE_ENABLED=true
AGENT_RESEARCH_ENABLED=true
AGENT_STRATEGY_ENABLED=true
# Optional recurring reviews; existing free Cron, PORTFOLIO_REVIEWS Workflow and shared AI budget.
AGENT_REVIEW_ENABLED=true
# AI, AGENT_DB and PORTFOLIO_REVIEWS are free-plan Worker bindings, not API keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
